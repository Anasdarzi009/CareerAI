# Environment Mode (production / development)
NODE_ENV=production

# Server Port (Render dynamically assigns this, defaults to 3000 locally)
PORT=3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/careerai?retryWrites=true&w=majority
MONGO_URI=

# JWT Authentication Secret Key
JWT_SECRET=

# Google Gemini API Key
GOOGLE_GENAI_API_KEY=

# Allowed Frontend Origins for CORS (Vercel production URL)
# Example: https://careerai.vercel.app
FRONTEND_URL=

# Additional CORS origins (comma-separated, optional)
# ALLOWED_ORIGINS=https://preview-deploy.vercel.app,https://mycustomdomain.com

# Puppeteer Configuration (Optional: automatically resolved via .puppeteerrc.cjs)
# PUPPETEER_CACHE_DIR=/opt/render/project/src/Backend/.cache/puppeteer
# PUPPETEER_EXECUTABLE_PATH=
